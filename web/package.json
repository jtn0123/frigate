    "form-data": "4.0.6",
    "i18next-cli": {
      "glob": "14.0.3"
    },
    "@hookform/resolvers": {
      "ajv-formats": "$ajv-formats"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array": {
