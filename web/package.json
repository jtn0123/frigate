    "@vitest/coverage-v8": "~4.1.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ast-v8-to-istanbul": "1.0.6",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
