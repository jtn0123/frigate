{
  "name": "web-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "postinstall": "patch-package",
    "build": "tsc && vite build --base=/BASE_PATH/",
    "lint": "eslint --cache --cache-strategy content --cache-location .cache/eslint/ . && npm run e2e:lint",
    "type-ratchet": "node scripts/fork/type-ratchet.mjs",
    "api-types": "node scripts/fork/gen-api-types.mjs",
    "api-types:ci": "node scripts/fork/gen-api-types.mjs --check",
    "e2e:lint": "node e2e/scripts/lint-specs.mjs && node e2e/scripts/validate-fixtures.mjs",
    "lint:fix": "eslint --cache --cache-strategy content --cache-location .cache/eslint/ --fix .",
    "typecheck": "tsc --incremental --tsBuildInfoFile .cache/tsc/app.tsbuildinfo && tsc -p tsconfig.e2e.json --incremental --tsBuildInfoFile .cache/tsc/e2e.tsbuildinfo && node scripts/fork/gen-api-types.mjs --check && node scripts/fork/typecheck-fork.mjs",
    "preview": "vite preview",
    "prettier:write": "prettier -u -w --ignore-path .gitignore \"*.{ts,tsx,js,jsx,css,html}\"",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "e2e:build": "tsc && vite build --base=/",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "i18n:extract": "i18next-cli extract",
    "i18n:extract:ci": "i18next-cli extract --ci",
    "i18n:status": "i18next-cli status",
    "bundle:budget": "node scripts/fork/bundle-budget.mjs"
  },
