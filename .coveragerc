[run]
branch = True
relative_files = True
source =
    frigate
    migrations
    testing-scripts
    fork/scripts
    fork/benchmarks
    fork/audio_trial
    fork/monitoring
omit =
    frigate/test/*
    fork/scripts/test_*.py
    frigate/version.py
    fork/**/test_*.py
    fork/audio_trial/smoke.py
    fork/audio_trial/startup_check.py
    fork/scripts/audio-recovery-check.py

[report]
show_missing = True
# 2026-10-04 exact-release baseline: 77.08% combined lines and branches.
# Allow one point of drift; the separate line floor is 78.83% +/- 1 point.
fail_under = 76.08
