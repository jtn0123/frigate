[run]
branch = True
relative_files = True
source =
    frigate
    migrations
    testing-scripts
    fork/scripts
    fork/benchmarks
    fork/audio_trial
    fork/monitoring
omit =
    frigate/test/*
    fork/scripts/test_*.py
    frigate/version.py
    fork/**/test_*.py
    fork/audio_trial/smoke.py
    fork/audio_trial/startup_check.py
    fork/scripts/audio-recovery-check.py

[report]
show_missing = True
# 2026-09-23 backend test-image baseline: 43% total coverage. Ratchet upward
# after adding behavior tests; Sonar's 80% new-code gate remains separate.
fail_under = 42
