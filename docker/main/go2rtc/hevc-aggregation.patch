--- /dev/null
+++ b/pkg/h265/rtp_aggregation_test.go
@@ -0,0 +1,43 @@
+package h265
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/AlexxIT/go2rtc/pkg/h264"
+	"github.com/pion/rtp"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRTPDepayAggregationHeaders(t *testing.T) {
+	vps := []byte{0x40, 1, 12}
+	sps := []byte{0x42, 1, 1}
+	pps := []byte{0x44, 1, 0xc0}
+	payload := []byte{48 << 1, 1}
+	for _, nalu := range [][]byte{vps, sps, pps} {
+		payload = binary.BigEndian.AppendUint16(payload, uint16(len(nalu)))
+		payload = append(payload, nalu...)
+	}
+	var got []byte
+	depay := RTPDepay(&core.Codec{}, func(p *rtp.Packet) { got = append([]byte(nil), p.Payload...) })
+	depay(&rtp.Packet{Header: rtp.Header{SequenceNumber: 1}, Payload: payload})
+	require.Nil(t, got)
+	depay(&rtp.Packet{Header: rtp.Header{SequenceNumber: 2, Marker: true}, Payload: []byte{19 << 1, 1, 0xab}})
+	require.Equal(t, h264.JoinNALU(vps, sps, pps, []byte{19 << 1, 1, 0xab}), got)
+}
+
+func TestRTPDepayRejectsMalformedAggregation(t *testing.T) {
+	for _, payload := range [][]byte{
+		{48 << 1, 1, 0},
+		{48 << 1, 1, 0, 10, 0x40, 1},
+		{48 << 1, 1, 0, 1, 0x40},
+	} {
+		t.Run(string(payload), func(t *testing.T) {
+			called := false
+			depay := RTPDepay(&core.Codec{}, func(_ *rtp.Packet) { called = true })
+			require.NotPanics(t, func() { depay(&rtp.Packet{Header: rtp.Header{Marker: true}, Payload: payload}) })
+			require.False(t, called)
+		})
+	}
+}
