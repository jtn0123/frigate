# Expiry date of the SONAR_TOKEN repository secret, as SonarCloud displays it
# (My Account > Security). Not a secret. Read by
# fork/scripts/sonar-token-expiry.py in the "sonar" job of "Fork - Checks",
# which warns from 14 days before this date and fails once it has passed.
# Update it whenever the token is rotated: fork/README.md, "Owner setup".
SONAR_TOKEN_EXPIRES=2026-10-11
