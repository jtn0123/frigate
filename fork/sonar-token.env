# Expiry of the SONAR_TOKEN repository secret, as SonarCloud displays it
# (My Account > Access Tokens). A date or never, not a secret. Read by
# fork/scripts/sonar-token-expiry.py in the "sonar" job of "Fork - Checks",
# which warns before a fixed date and verifies tokens with no fixed expiry.
# SonarCloud revokes a token with no fixed expiry after 60 inactive days.
# Update it whenever the token is rotated: fork/README.md, "Owner setup".
SONAR_TOKEN_EXPIRES=never
