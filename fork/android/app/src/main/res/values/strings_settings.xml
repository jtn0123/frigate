    <!-- Remote access (ui/RemoteAccessSettings.kt). -->
    <string name="set_wg_set_up">Set up WireGuard</string>
    <string name="set_wg_set_up_detail">Import the .conf file from your WireGuard VPN server, such as a UniFi gateway\'s, to watch away from home.</string>
    <string name="set_wg_choose_file">Choose the WireGuard file</string>
    <string name="set_wg_use_away">Use away from home</string>
    <string name="set_wg_allow_vpn">Allow the VPN connection</string>
    <string name="set_wg_allow_vpn_detail">Android asks once before the app can use its tunnel.</string>
    <string name="set_wg_use_app_tunnel">Use the app\'s tunnel instead</string>
    <string name="set_wg_use_app_tunnel_detail">Android runs one VPN at a time, so this turns the other VPN off.</string>
    <string name="set_wg_start_tunnel">Start the tunnel</string>
    <string name="set_wg_start_tunnel_detail">It was turned off outside the app, so the app does not start it again by itself.</string>
    <string name="set_wg_tunnel_file">Tunnel file</string>
    <string name="set_wg_imported">Imported</string>
    <!-- %1$s is the server the tunnel dials, such as "vpn.example.com:51820". -->
    <string name="set_wg_server">Server %1$s</string>
    <!-- %1$s is the file's name and %2$s its server: "home · Server vpn.example.com:51820". -->
    <string name="set_wg_file_and_server">%1$s · %2$s</string>
    <string name="set_wg_replace_or_remove">Replace or remove the tunnel file</string>
    <string name="set_wg_tunnel_log">Tunnel log</string>
    <string name="set_wg_tunnel_log_detail">What the tunnel did, to copy or share</string>
    <string name="set_wg_manage_detail">Only this app\'s connections go through the tunnel. Replace it with a new file, or remove it.</string>
    <string name="set_wg_replace">Replace</string>
    <string name="set_wg_remove">Remove</string>
    <string name="set_wg_remove_confirm">Remove the tunnel file?</string>
    <string name="set_wg_remove_detail">This deletes its private key from the phone. To use the tunnel again, import the file again.</string>
    <string name="set_wg_unreadable">Could not read that file.</string>
    <string name="set_wg_too_big">That file is too big to be a WireGuard file, which is a few hundred bytes. Pick the .conf file.</string>

    <!-- What to check when the VPN server never answers (ui/RemoteAccessSettings.kt). -->
    <string name="set_check_no_server">• The file names no server to connect to. Export it again.</string>
    <string name="set_check_title">Things to check:</string>
    <string name="set_check_client">• This phone\'s client is on the VPN server: saved (on UniFi, Apply Changes) before the file was downloaded, and not deleted or re-created since. The server ignores a key it does not know without a word, so a re-created client needs its new file.</string>
    <string name="set_check_server_on">• The VPN server is on, and not paused or turned off on the gateway.</string>
    <!-- %1$s is what kind of address the server is, such as "a public address". -->
    <string name="set_check_server_kind">• The file\'s server is %1$s.</string>
    <!-- %1$s is what kind of address the server is, such as "a private address". -->
    <string name="set_check_server_unreachable">• The file\'s server is %1$s. The internet cannot reach it, so export the file with your public address.</string>
    <!-- %1$d is the server's UDP port. -->
    <string name="set_check_udp">• UDP port %1$d is open to the internet. Some mobile networks block UDP: try another Wi-Fi too.</string>
    <string name="set_check_official_app">• The official WireGuard app connects with the same file. If it does not either, the cause is the server.</string>

    <!-- How the tunnel stands (ui/RemoteAccessSettings.kt). -->
    <string name="set_status_off">Off. The app only connects directly.</string>
    <string name="set_status_needs_permission">Waiting for Android to allow the VPN connection.</string>
    <string name="set_status_checking">Checking whether the server answers directly…</string>
    <string name="set_status_home">The server answers directly, so the tunnel is off.</string>
    <string name="set_status_other_vpn">The server answers through another VPN, so the tunnel is off.</string>
    <string name="set_status_other_vpn_in_the_way">Another VPN is on but does not reach the server. The app\'s tunnel would turn it off, so it waits for you.</string>
    <string name="set_status_stopped_outside">The tunnel was turned off outside the app, so it stays off for now.</string>
    <string name="set_status_no_network">No network. It connects when there is one.</string>
    <string name="set_status_connecting">Away from home. Connecting…</string>
    <string name="set_status_connected">Away from home, connected through the tunnel.</string>
    <!-- %1$s is why the tunnel failed, as the tunnel reported it. -->
    <string name="set_status_failed">Not connected. %1$s</string>

