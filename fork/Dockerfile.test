# Backend unit-test runner for the fork. Layers the working tree's Python
# sources over the matching upstream image so tests run against the exact
# runtime (labelmaps, ffmpeg, wheels) without a full image build.
ARG BASE
FROM ${BASE}
ARG TARGETARCH
WORKDIR /opt/frigate
# Release tooling tests exercise real throwaway Git repositories.
RUN apt-get update && apt-get install -y --no-install-recommends git \
  && rm -rf /var/lib/apt/lists/*
# Dev tools before the sources, so editing Python reuses this layer instead of
# re-running pip on every build. They come from the hash-pinned lock as wheels
# only; the check fails the build when requirements-dev.txt moved on without it.
COPY fork/requirements-sonar.txt /tmp/requirements-sonar.txt
COPY docker/main/requirements-dev.txt fork/requirements-dev.lock fork/scripts/dev-lock-check.py /tmp/dev/
RUN pip3 install --break-system-packages -q --require-hashes --only-binary :all: -r /tmp/dev/requirements-dev.lock \
  && pip3 install --break-system-packages -q --require-hashes --only-binary :all: -r /tmp/requirements-sonar.txt \
  && python3 /tmp/dev/dev-lock-check.py
# B20: exercise the new plugin-provider API against the same pinned ONNX
# Runtime wheel as production; the released base still contains 1.22.
COPY fork/requirements-runtime-${TARGETARCH}.lock /tmp/runtime.lock
RUN awk '/^onnxruntime==/ {found=1} found && /^[^[:space:]#]/ && !/^onnxruntime==/ {exit} found {print}' /tmp/runtime.lock > /tmp/onnxruntime.lock \
  && test -s /tmp/onnxruntime.lock \
  && pip3 install --break-system-packages -q --require-hashes --only-binary :all: --no-deps -r /tmp/onnxruntime.lock
COPY fork/scripts /opt/frigate/fork/scripts
# Data files the scripts read next to themselves: the reviewed advisory list
# (lock-audit.py) and the coverage floors (sonar-coverage-check.py).
COPY fork/audit-exceptions.json fork/coverage-floor.json /opt/frigate/fork/
COPY fork/requirements-runtime-*.lock /opt/frigate/fork/
COPY docker/main/requirements-wheels.txt docker/main/constraints-runtime-addons.txt /opt/frigate/docker/main/
COPY fork/audio_trial /opt/frigate/fork/audio_trial
COPY fork/monitoring /opt/frigate/fork/monitoring
COPY fork/benchmarks /opt/frigate/fork/benchmarks
# test_ledger.py validates the row files against the ledger's table
COPY FORK.md /opt/frigate/FORK.md
COPY fork/ledger /opt/frigate/fork/ledger
COPY .coveragerc /opt/frigate/.coveragerc
COPY testing-scripts /opt/frigate/testing-scripts
# Drop the base image's sources first: an upstream file this tree renamed or
# deleted would otherwise linger and be type checked and imported (D55).
RUN rm -rf /opt/frigate/frigate /opt/frigate/migrations
COPY frigate /opt/frigate/frigate
COPY migrations /opt/frigate/migrations
COPY generate_api_auth_spec.py /opt/frigate/generate_api_auth_spec.py
COPY docs/static/frigate-api.yaml /opt/frigate/docs/static/frigate-api.yaml
# The benchmark guard test checks the BuildKit pin against these workflows
COPY .github/workflows/fork-build-benchmark.yml .github/workflows/fork-concurrency-benchmark.yml /opt/frigate/.github/workflows/
RUN mkdir -p /config /media/frigate \
  && chown -R 1000:1000 /opt/frigate /config /media/frigate
USER 1000:1000
ENTRYPOINT ["python3", "-u", "-m", "unittest"]
