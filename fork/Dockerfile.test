# Backend unit-test runner for the fork. Layers the working tree's Python
# sources over the matching upstream image so tests run against the exact
# runtime (labelmaps, ffmpeg, wheels) without a full image build.
ARG BASE=ghcr.io/blakeblackshear/frigate:0.18.0-rc2
FROM ${BASE}
WORKDIR /opt/frigate
# Dev tools before the sources, so editing Python reuses this layer instead of
# re-running pip on every build. They come from the hash-pinned lock as wheels
# only; the check fails the build when requirements-dev.txt moved on without it.
COPY docker/main/requirements-dev.txt fork/requirements-dev.lock fork/scripts/dev-lock-check.py /tmp/dev/
RUN pip3 install --break-system-packages -q --require-hashes --only-binary :all: -r /tmp/dev/requirements-dev.lock \
  && python3 /tmp/dev/dev-lock-check.py
COPY frigate /opt/frigate/frigate
COPY migrations /opt/frigate/migrations
COPY fork/audio_trial /opt/frigate/fork/audio_trial
COPY generate_api_auth_spec.py /opt/frigate/generate_api_auth_spec.py
COPY docs/static/frigate-api.yaml /opt/frigate/docs/static/frigate-api.yaml
ENTRYPOINT ["python3", "-u", "-m", "unittest"]
